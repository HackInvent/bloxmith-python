{
  "kind": "python",
  "title": "Python",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "in",
        "title": "In",
        "accepts": [
          "message/*"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "out",
        "title": "Out",
        "emits": [
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "script": "def run(inputs, outputs, params):\n    outputs[\"out\"] = inputs.get(\"in\", \"\")\n",
    "timeout_sec": 10,
    "python_executable": "python3",
    "params": [],
    "dynamic_code_enabled": false,
    "code_input_port_id": null,
    "code_output_port_id": null
  },
  "port_capabilities": {
    "can_add_inputs": true,
    "can_add_outputs": true,
    "allow_required_input": true,
    "default_required": true
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  }
}
